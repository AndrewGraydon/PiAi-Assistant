[Unit]
Description=PiAi TTS Service (Kokoro on LLM8850)
Documentation=https://github.com/m5stack/kokoro.LM8850
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/PiAi/kokoro.LM8850
ExecStart=/usr/bin/python3 kokoro_svr.py --port 8803

Restart=on-failure
RestartSec=10
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piAi-tts

[Install]
WantedBy=multi-user.target
