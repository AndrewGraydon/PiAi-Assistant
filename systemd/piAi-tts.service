[Unit]
Description=PiAi TTS Service (Kokoro on LLM8850)
After=network.target piAi-llm.service

[Service]
Type=simple
User=andrew
Group=andrew
WorkingDirectory=/home/andrew/PiAi-Assistant
ExecStart=/bin/bash /home/andrew/PiAi-Assistant/services/tts/serve.sh

Restart=on-failure
RestartSec=10
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piAi-tts

[Install]
WantedBy=multi-user.target
