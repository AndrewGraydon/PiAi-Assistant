[Unit]
Description=PiAi LLM Service (Qwen3-4B on LLM8850)
Documentation=https://github.com/m5stack/LLM8850
After=network.target
# LLM takes ~133s to initialise on Pi 5 — other services can start in parallel

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/PiAi/Qwen3-4B

# Start tokenizer in background, wait 8s, then start the inference binary
# (matches the reference run_qwen3_4b_int8_ctx_axcl_aarch64.sh startup pattern)
ExecStart=/bin/bash -c '\
    python3 qwen3_tokenizer_uid.py --port 12300 & \
    sleep 8 && \
    ./main_axcl_aarch64 \
      --system_prompt "You are Qwen, created by Alibaba Cloud. You are a helpful assistant." \
      --template_filename_axmodel "qwen3-4b-ax650/qwen3_p128_l%%d_together.axmodel" \
      --axmodel_num 36 \
      --url_tokenizer_model "http://127.0.0.1:12300" \
      --filename_post_axmodel qwen3-4b-ax650/qwen3_post.axmodel \
      --filename_tokens_embed qwen3-4b-ax650/model.embed_tokens.weight.bfloat16.bin \
      --tokens_embed_num 151936 \
      --tokens_embed_size 2560 \
      --use_mmap_load_embed 1 \
      --live_print 1 \
      --devices 0'

# Kill tokenizer when main process exits
ExecStopPost=/bin/bash -c 'pkill -f "qwen3_tokenizer_uid.py --port 12300" || true'

Restart=on-failure
RestartSec=15
TimeoutStartSec=240
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piAi-llm

[Install]
WantedBy=multi-user.target
