[Unit]
Description=PiAi Display Sidecar (chatbot-ui.py)
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/PiAi/whisplay-ai-chatbot-llm8850/python
Environment=CUSTOM_FONT_PATH=/home/pi/PiAi/whisplay-ai-chatbot-llm8850/python/NotoSansSC-Bold.ttf
ExecStart=/usr/bin/python3 chatbot-ui.py

Restart=always
RestartSec=5
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piAi-display

[Install]
WantedBy=multi-user.target
