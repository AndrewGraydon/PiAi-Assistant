[Unit]
Description=PiAi Assistant Orchestrator
After=network.target piAi-llm.service piAi-asr.service piAi-tts.service
Wants=piAi-llm.service piAi-asr.service piAi-tts.service

[Service]
Type=simple
User=andrew
Group=andrew
WorkingDirectory=/home/andrew/PiAi-Assistant
EnvironmentFile=/home/andrew/PiAi-Assistant/.env

# Brief delay after dependencies start; health checks inside main.py
# wait up to 180s for NPU services to be ready
ExecStartPre=/bin/sleep 5
# Set WM8960 microphone gain (boost switches + PGA) and speaker volume
ExecStartPre=/bin/bash -c '\
  CARD=$(awk "/wm8960soundcard/{print $1}" /proc/asound/cards 2>/dev/null | head -n1); \
  [ -z "$CARD" ] && exit 0; \
  amixer -c "$CARD" cset numid=1 63,63 2>/dev/null; \
  amixer -c "$CARD" cset numid=9 3     2>/dev/null; \
  amixer -c "$CARD" cset numid=8 3     2>/dev/null; \
  amixer -c "$CARD" cset numid=50 on   2>/dev/null; \
  amixer -c "$CARD" cset numid=51 on   2>/dev/null; \
  amixer -c "$CARD" cset name="Speaker Playback Volume" 114,114 2>/dev/null || true'
ExecStart=/home/andrew/miniforge3/envs/piAi/bin/python /home/andrew/PiAi-Assistant/main.py --config /home/andrew/PiAi-Assistant/config.yaml

Restart=on-failure
RestartSec=15
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piAi-orchestrator

[Install]
WantedBy=multi-user.target
