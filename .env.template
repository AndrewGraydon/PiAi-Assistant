# ============================================================
# PiAi Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# Only secrets and API keys belong here.
# All service topology and structural config lives in config.yaml.
# ============================================================

# ------------------------------------------------------------
# Cloud Vision API Keys (only needed if vision.provider != placeholder)
# ------------------------------------------------------------
# Used when services.vision.provider = "gemini"
GEMINI_API_KEY=

# Used when services.vision.provider = "openai"
OPENAI_API_KEY=

# Used when services.vision.provider = "anthropic"
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# n8n Integration (only needed if n8n.enabled = true)
# n8n server runs at 10.10.0.40:5678
# Overrides n8n.token in config.yaml
# ------------------------------------------------------------
N8N_TOKEN=

# n8n MCP Server bearer token (for MCP protocol access)
# Used by the MCP endpoint at http://10.10.0.40:5678/mcp-server/http
N8N_MCP_BEARER_TOKEN=

# ------------------------------------------------------------
# Optional overrides
# ------------------------------------------------------------
# Override log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Sentence-transformers model cache directory (useful for offline Pi)
# SENTENCE_TRANSFORMERS_HOME=/home/pi/.cache/sentence_transformers

# Set to 1 to prevent sentence-transformers from downloading models
# TRANSFORMERS_OFFLINE=0
